{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/projects/[id]",
      "regex": "^/api/projects/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/projects/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/playground/[id]",
      "regex": "^/playground/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/playground/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/assignments",
      "regex": "^/api/assignments(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/assignments(?:/)?$"
    },
    {
      "page": "/api/events",
      "regex": "^/api/events(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/events(?:/)?$"
    },
    {
      "page": "/api/execute",
      "regex": "^/api/execute(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/execute(?:/)?$"
    },
    {
      "page": "/api/health",
      "regex": "^/api/health(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/health(?:/)?$"
    },
    {
      "page": "/api/projects",
      "regex": "^/api/projects(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/projects(?:/)?$"
    },
    {
      "page": "/api/tutor",
      "regex": "^/api/tutor(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/tutor(?:/)?$"
    },
    {
      "page": "/assignments",
      "regex": "^/assignments(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/assignments(?:/)?$"
    },
    {
      "page": "/challenges",
      "regex": "^/challenges(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/challenges(?:/)?$"
    },
    {
      "page": "/class",
      "regex": "^/class(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/class(?:/)?$"
    },
    {
      "page": "/compare",
      "regex": "^/compare(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/compare(?:/)?$"
    },
    {
      "page": "/lessons",
      "regex": "^/lessons(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/lessons(?:/)?$"
    },
    {
      "page": "/projects",
      "regex": "^/projects(?:/)?$",
